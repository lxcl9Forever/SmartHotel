<mxfile host="app.diagrams.net" type="device"><diagram id="26_deal_flow" name="每日优惠秒杀流程图"><mxGraphModel adaptiveColors="auto" dx="1600" dy="950" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="950"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="config" value="管理员设置房型、日期、配额、折扣" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#eaf2ff;strokeColor=#253957;fontColor=#253957;fontSize=22;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="260" height="110" as="geometry" /></mxCell><mxCell id="open" value="开启活动" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#eaf2ff;strokeColor=#253957;fontColor=#253957;fontSize=22;spacing=8;" vertex="1" parent="1"><mxGeometry x="395" y="180" width="260" height="110" as="geometry" /></mxCell><mxCell id="submit" value="顾客提交秒杀订单" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#eaf2ff;strokeColor=#253957;fontColor=#253957;fontSize=22;spacing=8;" vertex="1" parent="1"><mxGeometry x="725" y="180" width="265" height="110" as="geometry" /></mxCell><mxCell id="quota" value="名额与活动规则有效？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#eaf2ff;strokeColor=#253957;fontColor=#253957;fontSize=22;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="165" width="300" height="110" as="geometry" /></mxCell><mxCell id="stock" value="锁定跨日库存并计算价格" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#eaf2ff;strokeColor=#253957;fontColor=#253957;fontSize=22;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="470" width="300" height="110" as="geometry" /></mxCell><mxCell id="order" value="写订单并限时支付" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#eaf2ff;strokeColor=#253957;fontColor=#253957;fontSize=22;spacing=8;" vertex="1" parent="1"><mxGeometry x="725" y="470" width="265" he