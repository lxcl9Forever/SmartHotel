" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#677487;strokeWidth=2;endArrow=block;fontSize=20;" edge="1" source="quota" target="stock" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#677487;strokeWidth=2;endArrow=block;fontSize=20;" edge="1" source="stock" target="order" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#677487;strokeWidth=2;endArrow=block;fontSize=20;" edge="1" source="order" target="paid" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge7" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#677487;strokeWidth=2;endArrow=block;fontSize=20;" edge="1" source="paid" target="success" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge8" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#677487;strokeWidth=2;endArrow=block;fontSize=20;" edge="1" source="paid" target="expired" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge9" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#677487;strokeWidth=2;endArrow=block;fontSize=20;" edge="1" source="quota" target="soldout" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1490" y="290" /><mxPoint x="1490" y="790" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>